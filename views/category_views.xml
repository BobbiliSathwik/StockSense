<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Category List View -->
    <record id="view_stocksense_category_list" model="ir.ui.view">
        <field name="name">stocksense.category.list</field>
        <field name="model">stocksense.category</field>
        <field name="arch" type="xml">
            <list string="Product Categories">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Category Form View -->
    <record id="view_stocksense_category_form" model="ir.ui.view">
        <field name="name">stocksense.category.form</field>
        <field name="model">stocksense.category</field>
        <field name="arch" type="xml">
            <form string="Product Category">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="description"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Category Action -->
    <record id="action_stocksense_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">stocksense.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Categories Menu -->
    <menuitem
        id="menu_stocksense_categories"
        name="Categories"
        parent="menu_stocksense_root"
        action="action_stocksense_categories"
        sequence="20"
    />

</odoo>